# SAP Concur OAuth 2.0 Configuration
# ===================================

# Required - OAuth2 Client Credentials
# Get these from your Concur app registration
CONCUR_CLIENT_ID=your_client_id_here
CONCUR_CLIENT_SECRET=your_client_secret_here

# Concur API Base URL
# Common values:
#   US2: https://us2.api.concursolutions.com
#   US:  https://us.api.concursolutions.com
#   EU:  https://eu2.api.concursolutions.com
CONCUR_BASE_URL=https://us2.api.concursolutions.com

# OAuth2 Settings
# ===============

# Redirect URI for OAuth callback (must match app registration)
REDIRECT_URI=http://localhost:53682/callback

# Required OAuth scopes (space-separated)
CONCUR_SCOPE=openid expense.report.read expense.report.readwrite expense.report.workflowstatus.write identity.user.ids.read receipts.read user.read quickexpense.writeonly profile.user.generaluser.read profile.user.generalemployee.read travel.profile.user.event.read spenddocs.receipts.write spenddocs.receipts.writeonly receipts.writeonly identity.user.core.read

# Application Settings
# ====================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Automatically Managed - DO NOT EDIT MANUALLY
# ============================================
# These values are automatically updated by the application during authentication
CONCUR_ACCESS_TOKEN=
CONCUR_REFRESH_TOKEN=
CONCUR_ACCESS_TOKEN_EXPIRES_AT=
